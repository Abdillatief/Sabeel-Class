{
  "entities": {
    "User": {
      "title": "User",
      "description": "Teacher profile in Sabeel Academy",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "academy": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role", "gender", "academy", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student enrolled with a teacher",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "photo": { "type": "string", "maxLength": 500000 },
        "avatar": { "type": "string", "maxLength": 200 },
        "totalPoints": { "type": "number" },
        "badges": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "teacherId", "totalPoints", "createdAt"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Evaluation skill defined by teacher",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "points": { "type": "number" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "points", "teacherId", "createdAt"]
    },
    "PointHistory": {
      "title": "PointHistory",
      "description": "Log of points awarded to a student",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "skillName": { "type": "string", "maxLength": 100 },
        "points": { "type": "number" },
        "reason": { "type": "string", "maxLength": 300 },
        "date": { "type": "string" }
      },
      "required": ["studentId", "teacherId", "skillName", "points", "date"]
    },
    "Badge": {
      "title": "Badge",
      "description": "System badge definition",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 250 },
        "icon": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "description", "icon"]
    },
    "StudentBadge": {
      "title": "StudentBadge",
      "description": "Badge awarded to a student by a teacher",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "badgeId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 300 },
        "date": { "type": "string" }
      },
      "required": ["studentId", "badgeId", "teacherId", "date"]
    },
    "Competition": {
      "title": "Competition",
      "description": "Monthly competition setting",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "month": { "type": "string", "maxLength": 50 },
        "year": { "type": "number" },
        "teacherId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["teacher", "academy"] }
      },
      "required": ["title", "month", "year", "teacherId", "type"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued student certificate",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "rank": { "type": "string", "maxLength": 50 },
        "month": { "type": "string", "maxLength": 50 },
        "year": { "type": "number" },
        "points": { "type": "number" },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["studentId", "rank", "month", "year", "points", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Teacher profile"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records owned by teachers"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Skills created by teachers"
    },
    "/pointHistory/{id}": {
      "schema": "PointHistory",
      "description": "History of awarded points"
    },
    "/badges/{badgeId}": {
      "schema": "Badge",
      "description": "Predefined badges list"
    },
    "/studentBadges/{id}": {
      "schema": "StudentBadge",
      "description": "Record of badges granted to students"
    },
    "/competitions/{id}": {
      "schema": "Competition",
      "description": "Monthly competition details"
    },
    "/certificates/{id}": {
      "schema": "Certificate",
      "description": "Certificates issued to students"
    }
  }
}
